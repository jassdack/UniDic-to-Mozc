# Ignore generated TSV and CSV databases
*.csv
*.tsv
*.zip
output_tsvs/
output/

# 評価用テストセットは追跡する（生成物ではないため）
!eval/*.tsv

# OS specific temporary files
.DS_Store
Thumbs.db
desktop.ini

# Python cached files
__pycache__/
*.py[cod]
*$py.class
.mypy_cache/

# IDE and Editors
.vscode/
.idea/
*.swp
*.swo

# Virtual Environments
venv/
env/
.env

# eval/ が生成する Mozc の protobuf（google/mozc から取得。再配布しない）
eval/_mozc_proto/
